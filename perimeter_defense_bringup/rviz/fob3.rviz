Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Splitter Ratio: 0.55
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: false
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Base layout
      Enabled: true
      Topic:
        Value: /perimeter/layout_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Fleet symbols
      Enabled: true
      Topic:
        Value: /fleet/markers
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: Threats
      Enabled: true
      Topic:
        Value: /threats/markers
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_common/Group
      Name: LUP-1
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/RobotModel
          Name: Model
          Enabled: true
          Description Source: Topic
          Description Topic:
            Value: /lup1/robot_description
            Durability Policy: Transient Local
          TF Prefix: lup1
        - Class: rviz_default_plugins/LaserScan
          Name: Scan
          Enabled: true
          Topic:
            Value: /lup1/scan
            Reliability Policy: Best Effort
            Depth: 5
          Size (m): 0.05
          Color Transformer: FlatColor
          Color: 0; 200; 255
        - Class: rviz_default_plugins/Path
          Name: Plan
          Enabled: true
          Topic:
            Value: /lup1/plan
          Color: 80; 160; 255
        - Class: rviz_default_plugins/Map
          Name: Local costmap
          Enabled: false
          Topic:
            Value: /lup1/local_costmap/costmap
          Color Scheme: costmap
          Alpha: 0.5
    - Class: rviz_common/Group
      Name: LUP-2
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/RobotModel
          Name: Model
          Enabled: true
          Description Source: Topic
          Description Topic:
            Value: /lup2/robot_description
            Durability Policy: Transient Local
          TF Prefix: lup2
        - Class: rviz_default_plugins/LaserScan
          Name: Scan
          Enabled: true
          Topic:
            Value: /lup2/scan
            Reliability Policy: Best Effort
            Depth: 5
          Size (m): 0.05
          Color Transformer: FlatColor
          Color: 0; 255; 160
        - Class: rviz_default_plugins/Path
          Name: Plan
          Enabled: true
          Topic:
            Value: /lup2/plan
          Color: 80; 220; 160
    - Class: rviz_common/Group
      Name: LUP-3
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/RobotModel
          Name: Model
          Enabled: true
          Description Source: Topic
          Description Topic:
            Value: /lup3/robot_description
            Durability Policy: Transient Local
          TF Prefix: lup3
        - Class: rviz_default_plugins/LaserScan
          Name: Scan
          Enabled: true
          Topic:
            Value: /lup3/scan
            Reliability Policy: Best Effort
            Depth: 5
          Size (m): 0.05
          Color Transformer: FlatColor
          Color: 255; 200; 0
        - Class: rviz_default_plugins/Path
          Name: Plan
          Enabled: true
          Topic:
            Value: /lup3/plan
          Color: 230; 190; 60
  Enabled: true
  Global Options:
    Background Color: 18; 20; 18
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /lup1/goal_pose
    - Class: rviz_default_plugins/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      X: 20
      Y: 14
      Scale: 22
      Angle: 0
Window Geometry:
  Height: 900
  Width: 1500
