<package format="3">
  <name>perimeter_defense_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration: Gazebo world, robots with Nav2 and AMCL, scenarios, RViz.</description>
  <maintainer email="alexandrurizea58@gmail.com">Alexandru Rizea</maintainer>
