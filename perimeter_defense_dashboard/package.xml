<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perimeter_defense_dashboard</name>
  <version>0.1.0</version>
  <description>Web C2 dashboard of the perimeter defense exercise (rosbridge, Leaflet, MIL-STD-2525 symbols, MGRS grid).</description>
  <maintainer email="alexandrurizea58@gmail.com">Alexandru Rizea</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>perimeter_defense_msgs</exec_depend>
  <exec_depend>perimeter_defense_world</exec_depend>
  <exec_depend>perimeter_defense_viz</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
